@{
    ViewData["Title"] = "Page d'accueil";
}

<div class="jumbotron">
    <h1>Université Contoso</h1>
</div>
<div class="row">
    <div class="col-md-4">
        <h2>Bienvenue à l'Université Contoso</h2>
        <p>
            L'Université Contoso est une application exemple qui
            démontre comment utiliser Entity Framework Core dans une
            application web ASP.NET Core MVC.
        </p>
    </div>
    <div class="col-md-4">
        <h2>Construisez-la depuis le début</h2>
        <p>Vous pouvez construire l'application en suivant les étapes d'une série de tutoriels.</p>
        <p><a class="btn btn-primary" href="https://docs.asp.net/en/latest/data/ef-mvc/intro.html">Voir le tutoriel &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Téléchargez-la</h2>
        <p>Vous pouvez télécharger le projet complet depuis GitHub.</p>
        <p><a class="btn btn-primary" href="https://github.com/dotnet/AspNetCore.Docs/tree/main/aspnetcore/data/ef-mvc/intro/samples/5cu-final">Voir le code source du projet &raquo;</a></p>
    </div>
</div>